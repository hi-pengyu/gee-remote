# GEE配置
GEE_PROJECT_ID=your-gee-project-id
GEE_SCALE=10
GEE_DRIVE_FOLDER=GEE_Exports
GEE_SEARCH_WINDOW_DAYS=2

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password

# Celery配置
CELERY_BROKER_URL=redis://:<REDACTED_REDIS_PASSWORD>@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:<REDACTED_REDIS_PASSWORD>@localhost:6379/0

# 阿里云OSS配置
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=your-bucket-name
OSS_ENABLE_UPLOAD=false
OSS_DELETE_LOCAL=true

# 预测API配置
PREDICTION_API_URL=http://your-prediction-api-url/predict
PREDICTION_API_KEY=your-api-key
